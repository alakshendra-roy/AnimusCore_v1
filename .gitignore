# Build outputs, local tooling and secrets that should never be committed.
# Generic on purpose: this file names no private path, person or tool.

# --- build trees ------------------------------------------------------------
build/
build_*/
cmake-build-*/
out/
dist/
x64/
Debug/
Release/

# --- compiled objects, libraries and executables ----------------------------
*.o
*.obj
*.a
*.lib
*.exe
*.dll
*.so
*.dylib
*.pyd
*.pdb
*.ilk
*.iobj
*.ipdb
*.exp
*.tlog
*.recipe
*.lastbuildstate

# --- CMake / test output ----------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
benchmarks/_build/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.whl
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- editors and operating systems ------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.swp
.DS_Store
Thumbs.db
desktop.ini
~$*

# --- secrets and credentials -------------------------------------------------
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# --- local run output --------------------------------------------------------
*.log
*.tmp
/telemetry_benchmarks.json
/BENCHMARK_REPORT.json
